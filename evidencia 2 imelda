/* Estilos generales */
body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    text-align: center;
    margin: 0;
    padding: 20px;
}

/* Estilo para los títulos */
h1 {
    color: #333;
    background-color: #ffcc00;
    padding: 10px;
    border-radius: 10px;
    display: inline-block;
}

h2 {
    color: #555;
    font-size: 18px;
    margin: 10px 0;
}

/* Contenedor de las imágenes */
div img {
    width: 300px; /* Ajusta el tamaño de la imagen */
    height: auto;
    margin-top: 10px;
    border-radius: 10px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
}

/* Espaciado entre productos */
br {
    margin-bottom: 20px;
}
